{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/ws.js": {
      "maxDuration": 300
    },
    "api/session.js": {
      "maxDuration": 30
    },
    "api/workshop.js": {
      "maxDuration": 60
    },
    "api/report.js": {
      "maxDuration": 60
    },
    "api/command.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
